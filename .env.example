# ═════════════════════════════════════════════════════════════════════════════
# CityDB Environment Configuration
# ═════════════════════════════════════════════════════════════════════════════

# ─── 1. Database (Server-only) ────────────────────────────────────────────────
# PostgreSQL connection string with SSL support.
#
# • Local: Use Docker (docker-compose up -d postgres)
#   postgres://citydb:citydb@localhost:5432/citydb
#
# • Vercel / Production: Use Neon, Supabase, Railway Postgres, or AWS RDS:
#   postgres://user:password@ep-sample-1234.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://citydb:citydb@localhost:5432/citydb

# ─── 2. Authentication & Security (Server-only) ───────────────────────────────
# Secret key used to sign and verify JWT authentication tokens.
# Generate a strong 32+ character random string for production.
JWT_SECRET=citydb-super-secret-jwt-key-change-in-production-2026

# ─── 3. Google OAuth 2.0 (Optional) ───────────────────────────────────────────
# If enabled, users can sign in with their Google account.
# Obtain from: https://console.cloud.google.com/apis/credentials
#
# Server-side verification:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client-side Google Identity Services button (prefixed with VITE_ for Vite bundler):
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── 4. Runtime & Network (Server-only) ───────────────────────────────────────
# Node environment ("development" or "production").
NODE_ENV=development

# Port to bind to in standalone Express mode (Railway sets PORT automatically).
PORT=4000

# Allowed origin for CORS in production (set to your Vercel URL or Railway domain).
# Leave unset or "*" during development.
# CLIENT_URL=https://citydb.vercel.app

# ─── 5. Query Visualizer Safeguards (Server-only) ─────────────────────────────
# Max query timeout in milliseconds (default: 30000 = 30 seconds).
STATEMENT_TIMEOUT_MS=30000

# Set to "true" ONLY in local development to test DDL (CREATE INDEX, etc.).
# NEVER enable in production.
DEVELOPMENT_MODE=false

# ─── 6. Custom Transports (Optional, Client-side) ─────────────────────────────
# Custom WebSocket endpoint for standalone backend deployments.
# On Vercel, REST fallback is automatically used.
# VITE_WS_URL=ws://localhost:4000/ws
