# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local development: use docker-compose (see docker-compose.yml).
# Railway: set this to the value from your Railway PostgreSQL service.
# Neon / Supabase: paste the connection string provided by the dashboard.
DATABASE_URL=postgres://citydb:citydb@localhost:5432/citydb

# Node environment. Use "production" on Railway.
NODE_ENV=development

# Port to bind to. Railway sets this automatically — do NOT override it there.
# For local development, 4000 is the default.
PORT=4000

# ─── CORS (production) ────────────────────────────────────────────────────────

# Allowed origin for CORS in production.
# Set to your Railway app URL, e.g.: https://citydb-production.up.railway.app
# Leave unset or "*" for development.
# CLIENT_URL=https://your-app.up.railway.app

# ─── Optional ─────────────────────────────────────────────────────────────────

# Set to "true" to allow CREATE/INSERT/UPDATE/DELETE queries in the visualizer.
# WARNING: Never enable this in production — it allows data mutation.
# DEVELOPMENT_MODE=true

# Query timeout in milliseconds (default: 30000 = 30s).
# STATEMENT_TIMEOUT_MS=30000

# ─── Development only ─────────────────────────────────────────────────────────

# Override the WebSocket URL for the frontend (development only).
# When the frontend is served from Express on the same port, this is auto-derived.
# VITE_WS_URL=ws://localhost:4000/ws
