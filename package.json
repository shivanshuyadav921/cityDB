{
  "name": "citydb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "build": "npm run build --workspace=citydb-backend && npm run build --workspace=citydb-frontend",
    "build:backend": "npm run build --workspace=citydb-backend",
    "build:frontend": "npm run build --workspace=citydb-frontend",
    "start": "node backend/dist/server.js",
    "dev": "npm run dev --workspace=citydb-frontend",
    "dev:backend": "npm run dev --workspace=citydb-backend",
    "seed": "npm run seed --workspace=citydb-backend",
    "test": "npm run test --workspace=citydb-backend"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.0"
  }
}
