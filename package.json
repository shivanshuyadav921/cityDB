{
  "name": "citydb",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "install:all": "npm install --workspaces",
    "build": "npm run build --workspace=citydb-backend && npm run build --workspace=citydb-frontend",
    "build:backend": "npm run build --workspace=citydb-backend",
    "build:frontend": "npm run build --workspace=citydb-frontend",
    "start": "node backend/dist/server.js",
    "dev": "npm run dev --workspace=citydb-frontend",
    "dev:backend": "npm run dev --workspace=citydb-backend",
    "seed": "npm run seed --workspace=citydb-backend",
    "test": "npm run test --workspace=citydb-backend"
  },
  "engines": {
    "node": ">=20"
  }
}
